<section class="section"><div class="page-width"><div class="newsletter"><h2>{{ section.settings.heading }}</h2><div class="rte">{{ section.settings.text }}</div>{% form 'customer' %}<input type="hidden" name="contact[tags]" value="newsletter"><label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">{{ 'newsletter.label' | t }}</label><input class="field" id="NewsletterEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" required placeholder="{{ 'newsletter.label' | t }}"><button class="button" type="submit">{{ 'newsletter.button' | t }}</button>{% if form.posted_successfully? %}<p role="status">{{ 'newsletter.success' | t }}</p>{% endif %}{{ form.errors | default_errors }}{% endform %}</div></div></section>
{% schema %}
{"name":"Newsletter","settings":[{"type":"text","id":"heading","label":"Heading","default":"Good things, occasionally"},{"type":"richtext","id":"text","label":"Text","default":"<p>New arrivals, studio notes, and rare inbox treats.</p>"}],"presets":[{"name":"Newsletter"}]}
{% endschema %}
