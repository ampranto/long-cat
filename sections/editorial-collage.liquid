<section class="section" style="background:{{ section.settings.background }};color:{{ section.settings.text_color }}"><div class="page-width"><div class="grid items-start gap-10 lg:grid-cols-[.8fr_1.2fr]"><div class="lg:sticky lg:top-8" data-motion="reveal"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2 class="text-balance">{{ section.settings.heading }}</h2><div class="rte mb-8">{{ section.settings.text }}</div>{% if section.settings.button_label != blank %}<a class="button button--secondary" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>{% endif %}</div><div class="grid grid-cols-2 gap-4" data-motion-group>{% for block in section.blocks %}<figure class="{% if forloop.index == 1 %}col-span-2{% endif %}" data-motion-item {{ block.shopify_attributes }}>{% if block.settings.image %}{{ block.settings.image | image_url: width: 1400 | image_tag: class: 'w-full rounded-[var(--radius)] object-cover', loading: 'lazy', widths: '500, 800, 1100, 1400', alt: block.settings.image.alt | default: block.settings.caption }}{% else %}{{ 'lifestyle-' | append: forloop.index | placeholder_svg_tag: 'w-full rounded-[var(--radius)] bg-white' }}{% endif %}{% if block.settings.caption != blank %}<figcaption class="mt-3 text-sm">{{ block.settings.caption }}</figcaption>{% endif %}</figure>{% endfor %}</div></div></div></section>
{% schema %}
{"name":"Editorial collage","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Behind the objects"},{"type":"inline_richtext","id":"heading","label":"Heading","default":"A slower look at how it comes together"},{"type":"richtext","id":"text","label":"Text","default":"<p>Pair process photography, details, and lifestyle imagery with a concise brand story.</p>"},{"type":"text","id":"button_label","label":"Button label","default":"Visit the journal"},{"type":"url","id":"button_link","label":"Button link"},{"type":"color","id":"background","label":"Background","default":"#D9E4D3"},{"type":"color","id":"text_color","label":"Text","default":"#17231C"}],"blocks":[{"type":"image","name":"Image","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"caption","label":"Caption","default":"Detail, texture, and process"}]}],"max_blocks":5,"presets":[{"name":"Editorial collage","blocks":[{"type":"image"},{"type":"image"},{"type":"image"}]}]}
{% endschema %}
