<section class="section"><div class="page-width"><h1>{{ 'search.title' | t }}</h1><form action="{{ routes.search_url }}" method="get" role="search"><label class="visually-hidden" for="SearchInput">{{ 'search.placeholder' | t }}</label><input class="field" id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}"><button class="button" type="submit">{{ 'search.submit' | t }}</button></form>{% if search.performed %}<h2>{{ 'search.results_for' | t }} {{ search.terms | escape }}</h2>{% render 'facets', results: search %}{% paginate search.results by 12 %}<div class="grid grid--products">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', card_product: item %}{% else %}<article class="card"><div class="card__body"><h3><a href="{{ item.url }}">{{ item.title }}</a></h3><p>{{ item.content | strip_html | truncatewords: 24 }}</p></div></article>{% endif %}{% else %}<p>{{ 'search.no_results' | t }}</p>{% endfor %}</div>{% render 'pagination', paginate: paginate %}{% endpaginate %}{% endif %}</div></section>
{% schema %}{"name":"Main search","settings":[]}{% endschema %}
