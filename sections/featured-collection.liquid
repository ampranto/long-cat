<section class="section"><div class="page-width"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><div class="grid grid--products">
  {% if section.settings.collection != blank %}{% for product in section.settings.collection.products limit: section.settings.products_to_show %}{% render 'product-card', card_product: product %}{% endfor %}{% else %}{% for i in (1..4) %}<article class="card"><div class="card__media">{{ 'product-' | append: i | placeholder_svg_tag }}</div><div class="card__body"><h3>Sample product {{ i }}</h3><div class="price">{{ 2400 | money }}</div></div></article>{% endfor %}{% endif %}
</div></div></section>
{% schema %}
{"name":"Featured collection","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Fresh finds"},{"type":"text","id":"heading","label":"Heading","default":"Picked for right now"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"products_to_show","min":2,"max":8,"step":1,"default":4,"label":"Products to show"}],"presets":[{"name":"Featured collection"}]}
{% endschema %}
