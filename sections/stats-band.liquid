<section class="section" style="background:{{ section.settings.background }};color:{{ section.settings.text_color }}"><div class="page-width"><div class="mb-12 max-w-3xl" data-motion="reveal"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2 class="text-balance">{{ section.settings.heading }}</h2></div><div class="grid gap-px overflow-hidden rounded-[var(--radius)] bg-current/20 sm:grid-cols-2 lg:grid-cols-4" data-motion-group>{% for block in section.blocks %}<article class="bg-theme-surface p-7 text-theme-text" data-motion-item {{ block.shopify_attributes }}><div class="font-theme-heading text-5xl font-bold tracking-tight md:text-6xl">{{ block.settings.value }}</div><h3 class="mt-5">{{ block.settings.heading }}</h3><p>{{ block.settings.text }}</p></article>{% endfor %}</div></div></section>
{% schema %}
{"name":"Stats band","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Proof in the details"},{"type":"inline_richtext","id":"heading","label":"Heading","default":"Numbers worth sharing"},{"type":"color","id":"background","label":"Background","default":"#E7683F"},{"type":"color","id":"text_color","label":"Text","default":"#FFFFFF"}],"blocks":[{"type":"stat","name":"Stat","settings":[{"type":"text","id":"value","label":"Value","default":"24h"},{"type":"text","id":"heading","label":"Heading","default":"Thoughtful dispatch"},{"type":"textarea","id":"text","label":"Text","default":"A concise supporting detail goes here."}]}],"max_blocks":6,"presets":[{"name":"Stats band","blocks":[{"type":"stat"},{"type":"stat","settings":{"value":"4.9/5","heading":"Customer rating"}},{"type":"stat","settings":{"value":"12","heading":"Signature finishes"}},{"type":"stat","settings":{"value":"100%","heading":"Original point of view"}}]}]}
{% endschema %}
