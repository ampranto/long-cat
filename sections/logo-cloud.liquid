<section class="section" style="background:{{ section.settings.background }};color:{{ section.settings.text_color }}"><div class="page-width text-center"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2 class="mx-auto max-w-3xl text-balance">{{ section.settings.heading }}</h2><div class="mt-12 grid grid-cols-2 items-center gap-px overflow-hidden rounded-[var(--radius)] bg-current/15 md:grid-cols-3 lg:grid-cols-6">{% for block in section.blocks %}<div class="grid min-h-32 place-items-center bg-theme-surface p-6 text-theme-text" {{ block.shopify_attributes }}>{% if block.settings.logo %}{{ block.settings.logo | image_url: width: 360 | image_tag: class: 'max-h-12 w-auto opacity-70 grayscale', loading: 'lazy', widths: '160, 240, 360', alt: block.settings.name }}{% else %}<span class="font-theme-heading text-lg font-bold uppercase tracking-widest">{{ block.settings.name }}</span>{% endif %}</div>{% endfor %}</div></div></section>
{% schema %}
{"name":"Logo cloud","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Seen and shared"},{"type":"inline_richtext","id":"heading","label":"Heading","default":"In good company"},{"type":"color","id":"background","label":"Background","default":"#FFFFFF"},{"type":"color","id":"text_color","label":"Text","default":"#17231C"}],"blocks":[{"type":"logo","name":"Logo","settings":[{"type":"image_picker","id":"logo","label":"Logo image"},{"type":"text","id":"name","label":"Fallback name and alt text","default":"Journal"}]}],"max_blocks":12,"presets":[{"name":"Logo cloud","blocks":[{"type":"logo"},{"type":"logo","settings":{"name":"Form"}},{"type":"logo","settings":{"name":"Habitat"}},{"type":"logo","settings":{"name":"Studio"}},{"type":"logo","settings":{"name":"Sunday"}},{"type":"logo","settings":{"name":"Object"}}]}]}
{% endschema %}
