<section class="section"><div class="page-width"><h1>{{ section.settings.heading }}</h1><div class="grid grid--products">{% for collection in collections %}<article class="card"><a class="card__media" href="{{ collection.url }}">{% if collection.featured_image %}{{ collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', alt: collection.featured_image.alt | default: collection.title }}{% else %}{{ 'collection-1' | placeholder_svg_tag }}{% endif %}</a><div class="card__body"><h2><a href="{{ collection.url }}">{{ collection.title }}</a></h2><p>{{ collection.products_count }} products</p></div></article>{% endfor %}</div></div></section>
{% schema %}{"name":"Collections list","settings":[{"type":"text","id":"heading","label":"Heading","default":"Shop collections"}]}{% endschema %}
