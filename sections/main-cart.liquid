<section class="section"><div class="page-width"><h1>{{ 'cart.title' | t }}</h1>{% if cart.empty? %}<div class="empty-state"><p>{{ 'cart.empty' | t }}</p><a class="button" href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a></div>{% else %}
  {% form 'cart', cart %}<table class="cart-table"><thead><tr><th>Product</th><th>Quantity</th><th>Total</th></tr></thead><tbody>{% for item in cart.items %}<tr><td><a href="{{ item.url }}">{{ item.product.title }}</a>{% unless item.product.has_only_default_variant %}<div>{{ item.variant.title }}</div>{% endunless %}{% for discount in item.line_level_discount_allocations %}<div>{{ discount.discount_application.title }} (-{{ discount.amount | money }})</div>{% endfor %}<a href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a></td><td><label class="visually-hidden" for="Quantity-{{ item.index }}">{{ 'products.product.quantity' | t }}</label><input class="field" id="Quantity-{{ item.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0"></td><td>{{ item.final_line_price | money }}</td></tr>{% endfor %}</tbody></table>
  <div class="cart-summary">{% for discount in cart.cart_level_discount_applications %}<p>{{ 'cart.discount' | t }}: {{ discount.title }} (-{{ discount.total_allocated_amount | money }})</p>{% endfor %}<p><strong>{{ 'cart.subtotal' | t }}: {{ cart.total_price | money }}</strong></p><label for="CartNote">{{ 'cart.note' | t }}</label><textarea class="field" id="CartNote" name="note">{{ cart.note }}</textarea><p><button class="button button--secondary" type="submit" name="update">{{ 'cart.update' | t }}</button> <button class="button" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button></p>{{ content_for_additional_checkout_buttons }}</div>{% endform %}
{% endif %}</div></section>
{% schema %}{"name":"Main cart","settings":[]}{% endschema %}
