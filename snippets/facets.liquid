{% if results.filters.size > 0 %}<form class="facets" method="get">{% if results.terms %}<input type="hidden" name="q" value="{{ results.terms | escape }}">{% endif %}{% for filter in results.filters %}<details><summary>{{ filter.label }}</summary>{% case filter.type %}{% when 'boolean', 'list' %}{% for value in filter.values %}<label><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}> {{ value.label }} ({{ value.count }})</label>{% endfor %}{% when 'price_range' %}<label>Minimum <input class="field" name="{{ filter.min_value.param_name }}" type="number" min="0" value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"></label><label>Maximum <input class="field" name="{{ filter.max_value.param_name }}" type="number" min="0" value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"></label>{% endcase %}</details>{% endfor %}<button class="button" type="submit">Apply filters</button></form>{% endif %}
