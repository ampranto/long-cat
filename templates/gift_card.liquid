{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ 'gift_cards.issued' | t }} — {{ shop.name }}</title>
    {{ 'base.css' | asset_url | stylesheet_tag }}{{ content_for_header }}
  </head>
  <body><main class="empty-state page-width"><h1>{{ 'gift_cards.issued' | t }}</h1><p>{{ shop.name }}</p><p class="price">{{ gift_card.initial_value | money }}</p>{% unless gift_card.enabled %}<p>This gift card is disabled.</p>{% endunless %}{% if gift_card.expired %}<p>This gift card expired on {{ gift_card.expires_on | date: '%B %d, %Y' }}.</p>{% endif %}<div id="qr-code"></div><p>{{ gift_card.code | format_code }}</p><p>{{ 'gift_cards.remaining' | t }}: {{ gift_card.balance | money }}</p><a class="button" href="{{ shop.url }}">{{ 'gift_cards.shop_link' | t }}</a>{% if gift_card.pass_url %}<a href="{{ gift_card.pass_url }}"><img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="{{ 'gift_cards.add_to_apple_wallet' | t }}"></a>{% endif %}</main><script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer onload="new QRCode(document.getElementById('qr-code'), { text: '{{ gift_card.qr_identifier }}', width: 120, height: 120 });"></script></body>
</html>
