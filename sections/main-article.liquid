<article class="section"><div class="page-width" style="max-width:900px"><a href="{{ blog.url }}">{{ 'blogs.article.back_to_blog' | t }}</a><h1>{{ article.title }}</h1><p>{{ article.published_at | time_tag: format: 'date' }}{% if article.author %} · {{ article.author }}{% endif %}</p>{% if article.image %}{{ article.image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '750, 1100, 1600', alt: article.image.alt | default: article.title }}{% endif %}<div class="rte">{{ article.content }}</div></div></article>
{% schema %}{"name":"Main article","settings":[]}{% endschema %}
