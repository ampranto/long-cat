<section class="section" style="background:{{ section.settings.background }};color:{{ section.settings.text_color }}"><div class="page-width grid gap-10 lg:grid-cols-[.7fr_1.3fr]"><div data-motion="reveal"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2 class="text-balance">{{ section.settings.heading }}</h2><div class="rte">{{ section.settings.text }}</div></div><div class="border-t border-current/20">{% for block in section.blocks %}<div class="border-b border-current/20" x-data="disclosure({% if forloop.first and section.settings.open_first %}true{% else %}false{% endif %})" {{ block.shopify_attributes }}><h3 class="m-0"><button class="flex w-full items-center justify-between gap-6 py-6 text-left font-theme-heading text-xl font-bold" type="button" @click="toggle" :aria-expanded="open.toString()"><span>{{ block.settings.question }}</span><span class="text-theme-accent" aria-hidden="true" x-text="open ? '−' : '+'">+</span></button></h3><div class="rte pb-6" x-cloak x-show="open">{{ block.settings.answer }}</div></div>{% endfor %}</div></div></section>
{% schema %}
{"name":"Modern FAQ","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Good to know"},{"type":"inline_richtext","id":"heading","label":"Heading","default":"Questions, answered simply"},{"type":"richtext","id":"text","label":"Intro text","default":"<p>Use this space for shipping, materials, care, sizing, or anything customers ask often.</p>"},{"type":"checkbox","id":"open_first","label":"Open first question","default":true},{"type":"color","id":"background","label":"Background","default":"#F5F1E8"},{"type":"color","id":"text_color","label":"Text","default":"#17231C"}],"blocks":[{"type":"item","name":"Question","settings":[{"type":"text","id":"question","label":"Question","default":"What makes this collection different?"},{"type":"richtext","id":"answer","label":"Answer","default":"<p>Use a short, direct answer that helps the customer make a confident decision.</p>"}]}],"max_blocks":12,"presets":[{"name":"Modern FAQ","blocks":[{"type":"item"},{"type":"item","settings":{"question":"How quickly will my order arrive?"}},{"type":"item","settings":{"question":"How should I care for it?"}},{"type":"item","settings":{"question":"Can I send it as a gift?"}}]}]}
{% endschema %}
