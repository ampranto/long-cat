<section class="empty-state page-width"><h1>{% if settings.logo %}{{ settings.logo | image_url: width: settings.logo_width | image_tag: width: settings.logo_width, alt: shop.name }}{% else %}{{ shop.name }}{% endif %}</h1><div class="rte">{{ shop.password_message }}</div>{% form 'storefront_password' %}{{ form.errors | default_errors }}<label class="visually-hidden" for="Password">{{ 'password.password' | t }}</label><input class="field" id="Password" type="password" name="password" placeholder="{{ 'password.password' | t }}"><button class="button" type="submit">{{ 'password.submit' | t }}</button>{% endform %}<p>{{ 'password.admin_link_html' | t }}</p></section>
{% schema %}{"name":"Password page","settings":[]}{% endschema %}
