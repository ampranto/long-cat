<section class="section overflow-hidden" style="background:{{ section.settings.background }};color:{{ section.settings.text_color }}">
  <div class="page-width" data-motion="reveal"><div class="mb-10 flex flex-col justify-between gap-4 md:flex-row md:items-end"><div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2 class="max-w-3xl text-balance">{{ section.settings.heading }}</h2></div>{% if section.settings.link_label != blank %}<a class="button button--secondary" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>{% endif %}</div>
    <div class="grid gap-4 md:grid-cols-3" data-motion-group>{% for block in section.blocks %}<a class="group relative min-h-96 overflow-hidden rounded-[var(--radius)] bg-theme-surface" href="{{ block.settings.link }}" data-motion-item {{ block.shopify_attributes }}>{% if block.settings.image %}{{ block.settings.image | image_url: width: 1000 | image_tag: class: 'absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-105', loading: 'lazy', widths: '400, 700, 1000', alt: block.settings.image.alt | default: block.settings.title }}{% else %}{{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'absolute inset-0 h-full w-full object-cover' }}{% endif %}<span class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/5 to-transparent"></span><span class="absolute inset-x-0 bottom-0 p-6 text-white"><span class="block text-sm uppercase tracking-[.18em]">{{ block.settings.kicker }}</span><span class="font-theme-heading text-3xl font-bold">{{ block.settings.title }}</span></span></a>{% endfor %}</div>
  </div>
</section>
{% schema %}
{"name":"Category showcase","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Browse by mood"},{"type":"inline_richtext","id":"heading","label":"Heading","default":"Objects for every kind of day"},{"type":"text","id":"link_label","label":"Link label","default":"View all collections"},{"type":"url","id":"link","label":"Link"},{"type":"color","id":"background","label":"Background","default":"#E7E0D1"},{"type":"color","id":"text_color","label":"Text","default":"#17231C"}],"blocks":[{"type":"category","name":"Category","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"kicker","label":"Kicker","default":"Curated edit"},{"type":"text","id":"title","label":"Title","default":"The everyday edit"},{"type":"url","id":"link","label":"Link"}]}],"max_blocks":6,"presets":[{"name":"Category showcase","blocks":[{"type":"category"},{"type":"category","settings":{"title":"Color stories"}},{"type":"category","settings":{"title":"Quiet essentials"}}]}]}
{% endschema %}
