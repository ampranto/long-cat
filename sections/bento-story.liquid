<section class="section" style="background:{{ section.settings.background }};color:{{ section.settings.text_color }}"><div class="page-width"><div class="mb-10 max-w-3xl" data-motion="reveal"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2 class="text-balance">{{ section.settings.heading }}</h2><div class="rte">{{ section.settings.text }}</div></div><div class="grid auto-rows-[18rem] gap-4 md:grid-cols-3" data-motion-group>{% for block in section.blocks %}{% liquid
  assign size_class = ''
  if block.settings.size == 'wide'
    assign size_class = 'md:col-span-2'
  elsif block.settings.size == 'tall'
    assign size_class = 'md:row-span-2'
  endif
%}<article class="relative overflow-hidden rounded-[var(--radius)] bg-theme-surface {{ size_class }}" data-motion-item {{ block.shopify_attributes }}>{% if block.settings.image %}{{ block.settings.image | image_url: width: 1400 | image_tag: class: 'absolute inset-0 h-full w-full object-cover', loading: 'lazy', widths: '500, 800, 1100, 1400', alt: block.settings.image.alt | default: block.settings.heading }}{% else %}{{ 'lifestyle-' | append: forloop.index | placeholder_svg_tag: 'absolute inset-0 h-full w-full object-cover' }}{% endif %}<div class="absolute inset-0 bg-gradient-to-t from-black/65 to-transparent"></div><div class="absolute inset-x-0 bottom-0 p-6 text-white"><p class="eyebrow">{{ block.settings.label }}</p><h3 class="text-3xl">{{ block.settings.heading }}</h3></div></article>{% endfor %}</div></div></section>
{% schema %}
{"name":"Bento story","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"A visual journal"},{"type":"inline_richtext","id":"heading","label":"Heading","default":"A collection with many sides"},{"type":"richtext","id":"text","label":"Text","default":"<p>Mix product, process, and atmosphere in a flexible editorial grid.</p>"},{"type":"color","id":"background","label":"Background","default":"#17231C"},{"type":"color","id":"text_color","label":"Text","default":"#F5F1E8"}],"blocks":[{"type":"tile","name":"Tile","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"label","label":"Label","default":"Studio note"},{"type":"text","id":"heading","label":"Heading","default":"Designed to be noticed"},{"type":"select","id":"size","label":"Tile size","default":"normal","options":[{"value":"normal","label":"Normal"},{"value":"wide","label":"Wide"},{"value":"tall","label":"Tall"}]}]}],"max_blocks":8,"presets":[{"name":"Bento story","blocks":[{"type":"tile","settings":{"size":"wide"}},{"type":"tile","settings":{"heading":"Material matters"}},{"type":"tile","settings":{"heading":"Made for living","size":"tall"}},{"type":"tile","settings":{"heading":"A closer look","size":"wide"}}]}]}
{% endschema %}
