{% assign featured_product = section.settings.product %}
<section class="section overflow-hidden" style="background:{{ section.settings.background }};color:{{ section.settings.text_color }}"><div class="page-width grid items-center gap-10 lg:grid-cols-2 lg:gap-20"><div class="relative" data-motion="reveal"><span class="absolute -left-3 -top-3 z-10 rounded-full bg-theme-accent px-4 py-2 text-xs font-bold uppercase tracking-widest text-white">{{ section.settings.badge }}</span>{% if featured_product.featured_image %}{{ featured_product.featured_image | image_url: width: 1400 | image_tag: class: 'aspect-[4/5] w-full rounded-[var(--radius)] object-cover', loading: 'lazy', widths: '600, 900, 1200, 1400', alt: featured_product.featured_image.alt | default: featured_product.title }}{% else %}{{ 'product-1' | placeholder_svg_tag: 'aspect-[4/5] w-full rounded-[var(--radius)] bg-white object-cover' }}{% endif %}</div><div data-motion="reveal"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ featured_product.title | default: section.settings.placeholder_title }}</h2><div class="mb-6 text-xl font-bold">{% if featured_product %}{{ featured_product.price | money }}{% else %}{{ 4800 | money }}{% endif %}</div><div class="rte mb-8">{% if featured_product %}{{ featured_product.description | strip_html | truncatewords: 45 }}{% else %}{{ section.settings.text }}{% endif %}</div>{% if featured_product %}{% form 'product', featured_product %}<input type="hidden" name="id" value="{{ featured_product.selected_or_first_available_variant.id }}"><button class="button" type="submit"{% unless featured_product.available %} disabled{% endunless %}>{% if featured_product.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</button>{% endform %}{% else %}<a class="button" href="{{ section.settings.link }}">{{ section.settings.button_label }}</a>{% endif %}{% for block in section.blocks %}<div class="mt-6" {{ block.shopify_attributes }}>{% render block %}</div>{% endfor %}</div></div></section>
{% schema %}
{"name":"Product spotlight","settings":[{"type":"product","id":"product","label":"Product"},{"type":"text","id":"badge","label":"Badge","default":"Editor’s pick"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"One to know"},{"type":"text","id":"placeholder_title","label":"Placeholder title","default":"The statement piece"},{"type":"richtext","id":"text","label":"Placeholder text","default":"<p>Select a product to turn this demo into a shoppable spotlight.</p>"},{"type":"text","id":"button_label","label":"Placeholder button","default":"Discover the piece"},{"type":"url","id":"link","label":"Placeholder link"},{"type":"color","id":"background","label":"Background","default":"#F3B8A1"},{"type":"color","id":"text_color","label":"Text","default":"#17231C"}],"blocks":[{"type":"@app"}],"presets":[{"name":"Product spotlight"}]}
{% endschema %}
