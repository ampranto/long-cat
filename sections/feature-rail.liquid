<section class="section" style="background:{{ section.settings.background }};color:{{ section.settings.text_color }}"><div class="page-width"><div class="mb-12 grid gap-5 md:grid-cols-2"><div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2 class="text-balance">{{ section.settings.heading }}</h2></div><div class="rte self-end">{{ section.settings.text }}</div></div><div class="grid border-y border-current/20 md:grid-cols-2 lg:grid-cols-4" data-motion-group>{% for block in section.blocks %}<article class="border-b border-current/20 p-6 md:border-r lg:border-b-0" data-motion-item {{ block.shopify_attributes }}><div class="mb-8 text-3xl" aria-hidden="true">{{ block.settings.symbol }}</div><p class="eyebrow">0{{ forloop.index }}</p><h3>{{ block.settings.heading }}</h3><p>{{ block.settings.text }}</p></article>{% endfor %}</div></div></section>
{% schema %}
{"name":"Feature rail","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Built differently"},{"type":"inline_richtext","id":"heading","label":"Heading","default":"Small details do the heavy lifting"},{"type":"richtext","id":"text","label":"Text","default":"<p>Use this section for materials, service promises, craftsmanship, or product benefits.</p>"},{"type":"color","id":"background","label":"Background","default":"#F5F1E8"},{"type":"color","id":"text_color","label":"Text","default":"#17231C"}],"blocks":[{"type":"feature","name":"Feature","settings":[{"type":"text","id":"symbol","label":"Symbol","default":"✦"},{"type":"text","id":"heading","label":"Heading","default":"Considered materials"},{"type":"textarea","id":"text","label":"Text","default":"Chosen for feel, function, and a longer useful life."}]}],"max_blocks":6,"presets":[{"name":"Feature rail","blocks":[{"type":"feature"},{"type":"feature","settings":{"symbol":"↗","heading":"Made to last"}},{"type":"feature","settings":{"symbol":"◎","heading":"Easy to live with"}},{"type":"feature","settings":{"symbol":"◌","heading":"Thoughtful delivery"}}]}]}
{% endschema %}
