<section class="section"><div class="page-width"><h1>{{ page.title }}</h1><div class="rte">{{ page.content }}</div>{% form 'contact', class: 'contact-form' %}{% if form.posted_successfully? %}<p role="status">{{ 'contact.success' | t }}</p>{% endif %}{{ form.errors | default_errors }}<label for="ContactName">{{ 'contact.name' | t }}</label><input class="field" id="ContactName" name="contact[name]" autocomplete="name"><label for="ContactEmail">{{ 'contact.email' | t }}</label><input class="field" id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required><label for="ContactPhone">{{ 'contact.phone' | t }}</label><input class="field" id="ContactPhone" type="tel" name="contact[phone]" autocomplete="tel"><label for="ContactMessage">{{ 'contact.message' | t }}</label><textarea class="field" id="ContactMessage" name="contact[body]" rows="7" required></textarea><button class="button" type="submit">{{ 'contact.send' | t }}</button>{% endform %}</div></section>
{% schema %}{"name":"Contact form","settings":[]}{% endschema %}
