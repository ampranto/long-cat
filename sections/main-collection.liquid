<section class="section"><div class="page-width"><p class="eyebrow">Collection</p><h1>{{ collection.title }}</h1>{% if collection.description != blank %}<div class="rte">{{ collection.description }}</div>{% endif %}
  {% render 'facets', results: collection %}
  {% paginate collection.products by section.settings.products_per_page %}
    <div class="grid grid--products">{% for product in collection.products %}{% render 'product-card', card_product: product %}{% else %}<p>No products found.</p>{% endfor %}</div>{% render 'pagination', paginate: paginate %}
  {% endpaginate %}
</div></section>
{% schema %}
{"name":"Main collection","settings":[{"type":"range","id":"products_per_page","min":4,"max":24,"step":4,"default":12,"label":"Products per page"}]}
{% endschema %}
