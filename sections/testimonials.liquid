<section class="section"><div class="page-width"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><div class="quote-grid">{% for block in section.blocks %}<figure class="quote" {{ block.shopify_attributes }}><blockquote>“{{ block.settings.quote }}”</blockquote><figcaption>— {{ block.settings.author }}</figcaption></figure>{% endfor %}</div></div></section>
{% schema %}
{"name":"Testimonials","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Kind words"},{"type":"text","id":"heading","label":"Heading","default":"Loved in real life"}],"blocks":[{"type":"quote","name":"Quote","settings":[{"type":"textarea","id":"quote","label":"Quote","default":"Beautifully made and even better in person."},{"type":"text","id":"author","label":"Author","default":"Sample customer"}]}],"presets":[{"name":"Testimonials","blocks":[{"type":"quote"},{"type":"quote"},{"type":"quote"}]}]}
{% endschema %}
