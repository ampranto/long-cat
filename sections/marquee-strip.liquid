<section class="overflow-hidden border-y border-current/20 py-5" style="background:{{ section.settings.background }};color:{{ section.settings.text_color }}" aria-label="{{ section.settings.accessibility_label }}"><div class="atelier-marquee {% if section.settings.pause_on_hover %}atelier-marquee--pause{% endif %}" style="--marquee-speed:{{ section.settings.speed }}s"><div class="atelier-marquee__track">{% for repeat in (1..2) %}<div class="atelier-marquee__set"{% if repeat == 2 %} aria-hidden="true"{% endif %}>{% for block in section.blocks %}<span class="flex items-center gap-5 whitespace-nowrap px-5 font-theme-heading text-2xl font-bold md:text-4xl"{% if repeat == 1 %} {{ block.shopify_attributes }}{% endif %}>{{ block.settings.text }} <span class="text-theme-accent" aria-hidden="true">{{ block.settings.divider }}</span></span>{% endfor %}</div>{% endfor %}</div></div></section>
{% schema %}
{"name":"Marquee strip","settings":[{"type":"text","id":"accessibility_label","label":"Accessibility label","default":"Brand highlights"},{"type":"range","id":"speed","min":12,"max":50,"step":2,"unit":"s","default":24,"label":"Speed"},{"type":"checkbox","id":"pause_on_hover","label":"Pause on hover","default":true},{"type":"color","id":"background","label":"Background","default":"#F5F1E8"},{"type":"color","id":"text_color","label":"Text","default":"#17231C"}],"blocks":[{"type":"message","name":"Message","settings":[{"type":"text","id":"text","label":"Text","default":"Designed for everyday delight"},{"type":"text","id":"divider","label":"Divider","default":"✦"}]}],"max_blocks":8,"presets":[{"name":"Marquee strip","blocks":[{"type":"message"},{"type":"message","settings":{"text":"Expressive objects"}},{"type":"message","settings":{"text":"Made with intention"}}]}]}
{% endschema %}
