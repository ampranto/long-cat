<section class="empty-state page-width"><p class="eyebrow">404</p><h1>{{ section.settings.heading }}</h1><p>{{ section.settings.text }}</p><a class="button" href="{{ routes.root_url }}">{{ section.settings.button_label }}</a></section>
{% schema %}{"name":"404 page","settings":[{"type":"text","id":"heading","label":"Heading","default":"That page wandered off"},{"type":"text","id":"text","label":"Text","default":"Try the home page or continue browsing the shop."},{"type":"text","id":"button_label","label":"Button label","default":"Go home"}]}{% endschema %}
