[
  {
    "name": "theme_info",
    "theme_name": "Longcat Atelier",
    "theme_version": "1.0.0",
    "theme_author": "Theme author",
    "theme_documentation_url": "https://example.com/theme-documentation",
    "theme_support_url": "https://example.com/theme-support"
  },
  {
    "name": "Brand",
    "settings": [
      { "type": "image_picker", "id": "logo", "label": "Logo" },
      { "type": "range", "id": "logo_width", "min": 80, "max": 240, "step": 10, "unit": "px", "default": 140, "label": "Logo width" },
      { "type": "font_picker", "id": "heading_font", "default": "syne_n7", "label": "Heading font" },
      { "type": "font_picker", "id": "body_font", "default": "work_sans_n4", "label": "Body font" }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      { "type": "color", "id": "color_background", "default": "#F5F1E8", "label": "Background" },
      { "type": "color", "id": "color_text", "default": "#17231C", "label": "Text" },
      { "type": "color", "id": "color_accent", "default": "#E7683F", "label": "Accent" },
      { "type": "color", "id": "color_surface", "default": "#FFFFFF", "label": "Surface" },
      { "type": "range", "id": "radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 16, "label": "Corner radius" }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      { "type": "range", "id": "page_width", "min": 1000, "max": 1600, "step": 50, "unit": "px", "default": 1300, "label": "Page width" },
      { "type": "checkbox", "id": "show_vendor", "default": false, "label": "Show product vendors" },
      { "type": "checkbox", "id": "enable_quick_add", "default": true, "label": "Enable quick add" }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      { "type": "text", "id": "social_instagram", "label": "Instagram URL" },
      { "type": "text", "id": "social_tiktok", "label": "TikTok URL" },
      { "type": "text", "id": "social_pinterest", "label": "Pinterest URL" }
    ]
  }
]
