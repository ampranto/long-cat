<section class="section"><div class="page-width split"><div class="split__media">{% if section.settings.image %}{{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500, 750, 1000, 1200', alt: section.settings.image.alt }}{% else %}{{ 'lifestyle-1' | placeholder_svg_tag }}{% endif %}</div><div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><div class="rte">{{ section.settings.text }}</div>{% if section.settings.button_label != blank %}<a class="button button--secondary" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>{% endif %}</div></div></section>
{% schema %}
{"name":"Image with text","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Our point of view"},{"type":"inline_richtext","id":"heading","label":"Heading","default":"Useful can still feel wonderful"},{"type":"richtext","id":"text","label":"Text","default":"<p>We choose expressive forms, lasting materials, and details that reward a closer look.</p>"},{"type":"text","id":"button_label","label":"Button label","default":"Read our story"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"Image with text"}]}
{% endschema %}
