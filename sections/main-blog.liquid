<section class="section"><div class="page-width"><h1>{{ blog.title }}</h1>{% paginate blog.articles by section.settings.posts_per_page %}<div class="grid grid--products">{% for article in blog.articles %}<article class="card">{% if article.image %}<a class="card__media" href="{{ article.url }}">{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', alt: article.image.alt | default: article.title }}</a>{% endif %}<div class="card__body"><p class="eyebrow">{{ article.published_at | time_tag: format: 'date' }}</p><h2><a href="{{ article.url }}">{{ article.title }}</a></h2><p>{{ article.excerpt_or_content | strip_html | truncatewords: 28 }}</p><a href="{{ article.url }}">{{ 'blogs.article.read_more' | t }}</a></div></article>{% endfor %}</div>{% render 'pagination', paginate: paginate %}{% endpaginate %}</div></section>
{% schema %}{"name":"Main blog","settings":[{"type":"range","id":"posts_per_page","min":3,"max":18,"step":3,"default":9,"label":"Posts per page"}]}{% endschema %}
