<section class="section" style="background:{{ section.settings.background }};color:{{ section.settings.text_color }}"><div class="page-width"><div class="mb-10 max-w-3xl" data-motion="reveal"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2 class="text-balance">{{ section.settings.heading }}</h2><div class="rte">{{ section.settings.text }}</div></div><div class="grid gap-6 lg:grid-cols-[1.35fr_.65fr]"><div class="relative overflow-hidden rounded-[var(--radius)] bg-theme-surface">{% if section.settings.image %}{{ section.settings.image | image_url: width: 1800 | image_tag: class: 'aspect-[4/3] h-full w-full object-cover', loading: 'lazy', widths: '750, 1100, 1500, 1800', alt: section.settings.image.alt | default: section.settings.heading }}{% else %}{{ 'lifestyle-2' | placeholder_svg_tag: 'aspect-[4/3] h-full w-full object-cover' }}{% endif %}{% for block in section.blocks %}<a class="absolute grid h-9 w-9 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full border-2 border-white bg-theme-accent font-bold text-white shadow-lg transition hover:scale-110" style="left:{{ block.settings.x }}%;top:{{ block.settings.y }}%" href="{{ block.settings.product.url | default: block.settings.link }}" aria-label="{{ block.settings.product.title | default: block.settings.title }}" {{ block.shopify_attributes }}>{{ forloop.index }}</a>{% endfor %}</div><ol class="grid content-start gap-3">{% for block in section.blocks %}<li class="flex gap-4 rounded-[var(--radius)] bg-theme-surface p-4 text-theme-text"><span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-theme-accent font-bold text-white">{{ forloop.index }}</span><div><h3 class="mb-1 text-xl">{{ block.settings.product.title | default: block.settings.title }}</h3>{% if block.settings.product %}<p class="price">{{ block.settings.product.price | money }}</p><a href="{{ block.settings.product.url }}">View product</a>{% else %}<p>{{ block.settings.text }}</p>{% endif %}</div></li>{% endfor %}</ol></div></div></section>
{% schema %}
{"name":"Shoppable lookbook","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Shop the scene"},{"type":"inline_richtext","id":"heading","label":"Heading","default":"Everything in its favorite place"},{"type":"richtext","id":"text","label":"Text","default":"<p>Connect an editorial image to products with adjustable numbered hotspots.</p>"},{"type":"image_picker","id":"image","label":"Lookbook image"},{"type":"color","id":"background","label":"Background","default":"#F5F1E8"},{"type":"color","id":"text_color","label":"Text","default":"#17231C"}],"blocks":[{"type":"hotspot","name":"Product hotspot","settings":[{"type":"product","id":"product","label":"Product"},{"type":"text","id":"title","label":"Placeholder title","default":"Featured object"},{"type":"textarea","id":"text","label":"Placeholder text","default":"Select a product to make this point shoppable."},{"type":"url","id":"link","label":"Placeholder link"},{"type":"range","id":"x","label":"Horizontal position","min":5,"max":95,"step":1,"unit":"%","default":35},{"type":"range","id":"y","label":"Vertical position","min":5,"max":95,"step":1,"unit":"%","default":45}]}],"max_blocks":6,"presets":[{"name":"Shoppable lookbook","blocks":[{"type":"hotspot"},{"type":"hotspot","settings":{"title":"A second favorite","x":67,"y":30}},{"type":"hotspot","settings":{"title":"Finishing touch","x":75,"y":72}}]}]}
{% endschema %}
