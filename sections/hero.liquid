<section class="hero">
  {% if section.settings.image %}{{ section.settings.image | image_url: width: 2400 | image_tag: class: 'hero__media', loading: 'eager', fetchpriority: 'high', widths: '750, 1100, 1500, 2000, 2400', alt: section.settings.image.alt }}{% endif %}
  <div class="page-width hero__content"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h1>{{ section.settings.heading }}</h1><div class="rte">{{ section.settings.text }}</div>{% if section.settings.button_label != blank %}<a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>{% endif %}</div>
</section>
{% schema %}
{"name":"Hero","tag":"section","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Objects with personality"},{"type":"inline_richtext","id":"heading","label":"Heading","default":"Small delights. Big character."},{"type":"richtext","id":"text","label":"Text","default":"<p>A playful storefront for design-led goods, crafted to make browsing feel as good as buying.</p>"},{"type":"text","id":"button_label","label":"Button label","default":"Shop the collection"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"Hero"}]}
{% endschema %}
